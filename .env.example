# Production Security Watchtower — observational/read-only only.
WATCHTOWER_ENV=production
PLATFORM_NAME=must-tip
LOG_LEVEL=INFO

# Required high-entropy secret. Never commit the real value.
REDIS_PASSWORD=replace-with-a-secret-from-your-secret-manager
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=5.0

# Read-only repository root mounted as /workspace by Compose.
WATCHTOWER_SOURCE_ROOT=../..

# Optional alert channels. Keep credentials in the untracked .env or secret manager.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# TELEGRAM_BOT_TOKEN=replace-with-secret-manager-reference
# TELEGRAM_CHAT_ID=replace-with-chat-id
# GENERIC_WEBHOOK_URL=https://alerts.example.net/watchtower
MIN_ALERT_SEVERITY=HIGH
ALERT_COOLDOWN_SECS=300
NOTIFIER_TIMEOUT=10.0
NOTIFIER_MAX_RETRIES=3

# Required complete HTTPS health endpoint URLs. No base URLs, credentials,
# query strings, fragments, localhost, loopback, link-local, multicast, or
# unspecified addresses.
API_WATCHER_TARGETS=
API_POLL_INTERVAL=15.0
API_REQUEST_TIMEOUT=8.0
API_FAILURE_THRESHOLD=3
API_LATENCY_WARN_MS=2000.0
API_MAX_CONCURRENT=10

# Compose overrides this to /workspace/components.
CODE_WATCH_PATHS=/workspace/components
CODE_WATCH_EXTENSIONS=.py,.js,.ts,.go,.java,.sol
CODE_SCAN_ON_START=true
CODE_SECRET_SCAN=true
CODE_IGNORE_PATHS=node_modules,.git,__pycache__,.venv,.venv-platform,dist,build,coverage,staticfiles

CORRELATOR_WINDOW=300.0
CORRELATOR_BUFFER_SIZE=500
CORRELATOR_MIN_CONFIDENCE=0.6
CORRELATOR_POLL_TIMEOUT=5.0
